async function handleFile(input){
  const file=input.files?.[0];if(!file)return;
  const btn=document.getElementById('ubtn'),al=document.getElementById('ualert');
  btn.disabled=true;btn.innerHTML='<span class="spin">⏳</span> Leyendo archivo...';al.style.display='none';
  try{
    const ab=await file.arrayBuffer();
    const wb=XLSX.read(ab,{type:'array'});
    const days={};
    const firstName=(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,defval:''})[0]?.[0]||'').toString().trim();
    wb.SheetNames.forEach((sh,idx)=>{
      const ws=wb.Sheets[sh];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
      const exs=[];
      rows.forEach(row=>{
        const raw=(row[0]||'').toString().trim();
        if(!raw||raw.toLowerCase().includes('ejercicio')||/^día\s*\d/i.test(raw))return;
        const cols=[row[3],row[5],row[7],row[9],row[11],row[13]];
        if(!cols.some(c=>c))return;
        const parts=raw.split('\n');
        const mainName=parts[0].replace(/\s*\([^)]*\)\s*/g,'').trim();
        const noteFromNewline=parts.slice(1).join(' ').replace(/[()]/g,'').trim();
        const noteFromParens=(raw.match(/\(([^)]+)\)/)||[])[1]||'';
        const note=noteFromNewline||noteFromParens||'';
        const reps=cols.map(v=>{const s=(v||'').toString().trim();if(!s)return'—';if(/rir\s*(\d)/i.test(s)){const m=s.match(/rir\s*(\d)/i);return'RIR'+(m?m[1]:'1');}const m=s.match(/\d+x([0-9,\.]+(?:[\/\-–][0-9,\.]+)?(?:m)?)/);return m?m[1]:s;});
        const rir=cols.map(v=>{const s=(v||'').toString().trim();if(!s)return'—';if(/rir\s*(\d)/i.test(s)){const m=s.match(/rir\s*(\d)/i);return m?m[1]:'1';}if(/\(F\)/i.test(s))return'F';const m=s.match(/\(([^)]+)\)/);return m?m[1]:'—';});
        exs.push({name:mainName,note,sets:3,reps,rir});
      });
      if(exs.length)days[idx+1]=exs;
    });
    if(!Object.keys(days).length)throw new Error('Sin ejercicios');
    const metaName=firstName||file.name.replace('.xlsx','');
    R={meta:{name:metaName,totalWeeks:12},days};
    localStorage.setItem('routine',JSON.stringify(R));
    localStorage.setItem('routineCustom','1');
    localStorage.setItem('cWeek','1');
    cW=1;cD=1;SD={};
    buildW();buildD();buildPS();updateHdr();renderSI();
    al.className='al ok';al.textContent=`✅ "${metaName}" cargada — ${Object.keys(days).length} días`;al.style.display='block';
  }catch(e){
    al.className='al err';al.textContent='⚠️ No se pudo leer el Excel. Revisa que el formato sea correcto.';al.style.display='block';
  }finally{
    btn.disabled=false;btn.innerHTML='📊 Subir Excel del nuevo mesociclo';input.value='';
  }
}


