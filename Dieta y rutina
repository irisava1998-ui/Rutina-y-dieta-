2", "RIR2", "RIR2", "RIR2"], "rir": ["2", "2", "2", "2", "2", "2"]}, {"name": "Rodillas al pecho en fondos", "note": "", "sets": 3, "reps": ["RIR1", "RIR1", "RIR1", "RIR1", "RIR1", "RIR1"], "rir": ["1", "1", "1", "1", "1", "1"]}]}};

const MCL=["MC 1-2","MC 3-4","MC 5-6","MC 7-8","MC 9-10","MC 11-12"];
if(localStorage.getItem('dv')!=='m11'){localStorage.setItem('dv','m11');localStorage.setItem('cWeek','1');}
let R=(localStorage.getItem('routineCustom')==='1'?JSON.parse(localStorage.getItem('routine')||'null'):null)||DEFAULT;
let H=JSON.parse(localStorage.getItem('history')||'[]');
let cW=parseInt(localStorage.getItem('cWeek')||'1');
let cD=1,cV='Workout',SD={};

const mci=w=>Math.floor((w-1)/2);
const wlbl=w=>w%2===1?'1ª semana del bloque':'2ª semana del bloque';
const sk=(d,w)=>`d${d}w${w}`;
const es=n=>Array.from({length:n},()=>({reps:'',weight:'',rir:'',done:false}));
const tw=()=>R.meta?.totalWeeks||12;

function init(){buildW();buildD();buildPS();updateHdr();renderEx();renderSI();}

function buildW(){
  const sc=document.getElementById('wscroll');sc.innerHTML='';
  const mi=mci(cW);
  for(let w=1;w<=tw();w++){
    const b=document.createElement('button');
    b.className='wbtn'+(w===cW?' on':mci(w)===mi?' mc':'');
    b.textContent=w;b.dataset.w=w;b.onclick=()=>selW(w);sc.appendChild(b);
  }
  setTimeout(()=>{const b=document.querySelector(`[data-w="${cW}"]`);if(b)b.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});},50);
}

function buildD(){
  const t=document.getElementById('dtabs');t.innerHTML='';
  Object.keys(R.days).forEach(d=>{
    const b=document.createElement('button');
    b.className='dtab'+(parseInt(d)===cD?' on':'');
    b.textContent='Día '+d;b.onclick=()=>selD(parseInt(d));t.appendChild(b);
  });
}

function buildPS(){
  const s=document.getElementById('psel');s.innerHTML='';
  Object.values(R.days).flat().map(e=>e.name).filter((v,i,a)=>a.indexOf(v)===i).forEach(n=>{
    const o=document.createElement('option');o.value=n;o.textContent=n;s.appendChild(o);
  });
}

function updateHdr(){
  const mi=mci(cW);
  document.getElementById('logo').innerHTML=(R.meta?.name||'Gym Tracker').replace(/(\d+)/,'<b>$1</b>');
  document.getElementById('wbadge').textContent='Sem. '+cW;
  document.getElementById('wsub').textContent=MCL[mi]+' · '+wlbl(cW);
}

function selW(w){cW=w;localStorage.setItem('cWeek',w);buildW();updateHdr();renderEx();}
function shiftW(d){selW(Math.max(1,Math.min(tw(),cW+d)));}
function selD(d){cD=d;document.querySelectorAll('.dtab').forEach((b,i)=>b.classList.toggle('on',parseInt(Object.keys(R.days)[i])===d));renderEx();}

// Get previous week sets for an exercise
function getPrevSets(exName, day, week) {
  if(week<=1) return null;
  // Look for same day, previous week
  const prevSess = [...H].reverse().find(s=>s.meso===R.meta.name && s.day===day && s.week===(week-1) && s.exercises?.some(e=>e.name===exName));
  if(!prevSess) return null;
  return prevSess.exercises.find(e=>e.name===exName)?.sets || null;
}

function lastMaxWeight(name){
  for(let i=H.length-1;i>=0;i--){
    const ex=H[i].exercises?.find(e=>e.name===name);
    if(ex){const ws=ex.sets.filter(s=>s.weight).map(s=>parseFloat(s.weight));if(ws.length)return Math.max(...ws);}
  }return null;
}

function renderEx(){
  const list=document.getElementById('exlist');list.innerHTML='';
  const exs=R.days[cD]||[];
  const key=sk(cD,cW);if(!SD[key])SD[key]={};
  const mi=mci(cW);

  exs.forEach((ex,ei)=>{
    if(!SD[key][ei])SD[key][ei]=es(ex.sets);
    const sets=SD[key][ei];
    const tr=ex.reps?.[mi]||'—', trir=ex.rir?.[mi]||'—';
    const prevSets=getPrevSets(ex.name, cD, cW);
    const lw=lastMaxWeight(ex.name);
    const lit=sets.some(s=>s.weight||s.reps);

    const c=document.createElement('div');
    c.className='ecard'+(lit?' lit':'');

    // Build set rows HTML
    let setsHTML='';
    sets.forEach((s,si)=>{
      const prev=prevSets?.[si];
      const prevKg=prev?.weight||'';
      const prevReps=prev?.reps||'';
      const prevRir=prev?.rir||'';
      const hasPrev=prevKg||prevReps;
      const isF=s.rir&&s.rir.toString().toUpperCase()==='F';

      setsHTML+=`<div class="sgrid">
        <div class="snum">${si+1}</div>
        <input class="sinput" type="text" inputmode="numeric" placeholder="${tr}" value="${s.reps}" oninput="upd(${ei},${si},'reps',this.value)">
        <input class="sinput" type="text" inputmode="decimal" placeholder="kg" value="${s.weight}" oninput="upd(${ei},${si},'weight',this.value)">
        <input class="sinput${isF?' rir-f':''}" type="text" inputmode="text" placeholder="${trir}" value="${s.rir}" oninput="updRir(${ei},${si},this)" id="rir_${ei}_${si}">
        <button class="sdone${s.done?' on':''}" onclick="togDone(${ei},${si},this)">${s.done?'✓':''}</button>
      </div>`;
      if(hasPrev){
        setsHTML+=`<div class="prev-row">
          <div></div>
          <div class="prev-cell">↑${prevReps||'—'}</div>
          <div class="prev-cell">${prevKg?prevKg+'kg':'—'}</div>
          <div class="prev-cell">R${prevRir||'—'}</div>
          <div></div>
        </div>`;
      }
    });

    c.innerHTML=`
      <div class="ehdr" onclick="togEx(${ei})">
        <div style="flex:1">
          <div class="ename">${ex.name}</div>
          ${ex.note?`<div class="enote">${ex.note}</div>`:''}
          <div class="emeta">${ex.sets} series · ${tr} reps · RIR ${trir}</div>${hint(tr,prevSets)}
          ${lw?`<div class="elast">↑ Mejor marca: ${lw} kg</div>`:''}
        </div>
        <div class="echev" id="ch${ei}">›</div>
      </div>
      <div class="sbody" id="sb${ei}">
        <div class="slbl" style="display:flex;justify-content:space-between;align-items:center">Registrar series${prevSets?`<button class="addb" onclick="copyPrev(${ei})">↺ Copiar sem. anterior</button>`:''}</div>
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <button class="rir-chip" onclick="setAllRir(${ei},'0')">RIR 0</button>
          <button class="rir-chip" onclick="setAllRir(${ei},'1')">RIR 1</button>
          <button class="rir-chip" onclick="setAllRir(${ei},'2')">RIR 2</button>
          <button class="rir-chip" onclick="setAllRir(${ei},'3')">RIR 3</button>
          <button class="rir-chip" onclick="setAllRir(${ei},'F')" style="color:var(--danger);border-color:var(--danger)">Fallo</button>
        </div>
        <div class="clbls"><div class="clbl"></div><div class="clbl">Reps</div><div class="clbl">Kg</div><div class="clbl">RIR</div><div class="clbl">✓</div></div>
        ${prevSets?`<div style="font-size:10px;color:var(--ok);font-weight:700;margin-bottom:6px;text-align:center">↑ Verde = semana anterior</div>`:''}
        ${setsHTML}
      </div>`;
    list.appendChild(c);
  });
}

function togEx(ei){
  const sb=document.getElementById('sb'+ei),ch=document.getElementById('ch'+ei);
  const o=sb.classList.toggle('open');ch.classList.toggle('open',o);ch.textContent=o?'↓':'›';
}

function upd(ei,si,f,v){
  const k=sk(cD,cW);
  if(!SD[k][ei])SD[k][ei]=es(R.days[cD][ei].sets);
  SD[k][ei][si][f]=v;
}

function updRir(ei,si,input){
  const v=input.value;
  upd(ei,si,'rir',v);
  input.classList.toggle('rir-f', v.toUpperCase()==='F');
}

function setAllRir(ei,val){
  const k=sk(cD,cW);
  if(!SD[k][ei])SD[k][ei]=es(R.days[cD][ei].sets);
  const n=SD[k][ei].length;
  for(let si=0;si<n;si++){
    SD[k][ei][si].rir=val;
    const input=document.getElementById('rir_'+ei+'_'+si);
    if(input){
      input.value=val;
      input.classList.toggle('rir-f',val.toUpperCase()==='F');
    }
  }
}

function togDone(ei,si,btn){
  const k=sk(cD,cW);
  const d=!SD[k][ei][si].done;
  SD[k][ei][si].done=d;
  btn.classList.toggle('on',d);
  btn.textContent=d?'✓':'';
}

function saveSession(){
  const k=sk(cD,cW),data=SD[k];
  const exs=(R.days[cD]||[]).map((ex,ei)=>({name:ex.name,sets:(data?.[ei]||es(ex.sets)).map(s=>({...s}))})).filter(ex=>ex.sets.some(s=>s.reps||s.weight));
  if(!exs.length){showToast('⚠️ Añade datos antes de guardar');return;}
  // Remove existing session for same day+week to avoid duplicates
  H=H.filter(s=>!(s.meso===R.meta.name&&s.day===cD&&s.week===cW));
  const sess={meso:R.meta.name,id:Date.now(),date:new Date().toLocaleDateString('es-ES',{day:'2-digit',month:'short',year:'numeric'}),day:cD,week:cW,microciclo:MCL[mci(cW)],exercises:exs};
  const e1=(w,r)=>w*(1+(parseFloat(r)||0)/30),best=n=>Math.max(0,...H.flatMap(x=>x.exercises).filter(e=>e.name===n).flatMap(e=>e.sets).map(t=>e1(parseFloat(t.weight)||0,t.reps)));
  sess.pr=exs.filter(e=>{const b=best(e.name),m=Math.max(0,...e.sets.map(t=>e1(parseFloat(t.weight)||0,t.reps)));return b>0&&m>b;}).map(e=>e.name);
  sess.vol=Math.round(exs.reduce((a,e)=>a+e.sets.reduce((b,t)=>b+(parseFloat(t.weight)||0)*(parseFloat(t.reps)||0),0),0));
  H.push(sess);
  localStorage.setItem('history',JSON.stringify(H));
  localStorage.setItem('cWeek',cW);
  showToast('✅ '+sess.vol+' kg guardados'+(sess.pr.length?' · 🏆 '+sess.pr.length+' récord':''));
}

function showToast(m){
  const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}

function switchV(v){
  cV=v;
  ['Workout','History','Progress','Settings','Nutri','Plan','Home'].forEach(id=>{
    const el=document.getElementById('v'+id);
    if(el)el.style.display=id===v?(id==='Workout'?'flex':'block'):'none';
  });
  ['W','History','Progress','Nutri','Plan'].forEach(id=>{
    const b=document.getElementById('n'+id);
    if(b)b.classList.toggle('on',id===v||(id==='W'&&v==='Workout'));
  });
  document.getElementById('fab').style.display=v==='Workout'?'flex':'none';
  document.getElementById('wrow').style.display=['Settings','Nutri','Plan','Home'].includes(v)?'none':'flex';
  document.getElementById('wbadge').style.display=['Settings','Nutri','Plan','Home'].includes(v)?'none':'block';
  if(v==='History')renderHist();
  if(v==='Progress')renderProg();
  if(v==='Nutri')renderN();
  if(v==='Plan')renderP();
  if(v==='Home')renderHome();
}

function toggleSettings(){
  if(cV==='Settings'){switchV('Workout');document.getElementById('sbtn').classList.remove('on');}
  else{
    ['Workout','History','Progress','Nutri','Plan','Home'].forEach(id=>{const el=document.getElementById('v'+id);if(el)el.style.display='none';});
    document.getElementById('vSettings').style.display='block';
    document.getElementById('fab').style.display='none';
    document.getElementById('wrow').style.display='none';
    document.getElementById('wbadge').style.display='none';
    document.getElementById('sbtn').classList.add('on');
    ['W','History','Progress','Nutri','Plan'].forEach(id=>{const b=document.getElementById('n'+id);if(b)b.classList.remove('on');});
    cV='Settings';renderSI();
  }
}

function renderHist(){
  const c=document.getElementById('vHistory');
  if(!H.length){c.innerHTML='<div class="empty"><div class="eicon">📋</div><div class="etxt">Aún no hay sesiones.<br>¡A entrenar! 💪</div></div>';return;}
  c.innerHTML=[...H].reverse().map(s=>`
    <div class="hcard">
      <div class="hhead">
        <div><div class="hdate">${s.date}</div><div class="hmeta">Semana ${s.week} · ${s.microciclo}${s.vol?' · '+s.vol+' kg':''}${s.dur?' · '+s.dur+' min':''}${s.pr&&s.pr.length?' · 🏆'+s.pr.length:''}</div></div>
        <div class="hday">Día ${s.day}</div>
      </div>
      ${s.exercises.map((ex,i)=>`
        <div class="hex" style="${i===s.exercises.length-1?'border-bottom:none':''}">
          <div class="hexn">${ex.name}</div>
          <div class="hsets">${ex.sets.map((st,si)=>{
            const isFallo=st.rir&&st.rir.toString().toUpperCase()==='F';
            return `<div class="hchip${isFallo?' fallo':''}">S${si+1}: <b>${st.weight||'—'}kg</b> × ${st.reps||'—'} · RIR ${st.rir||'—'}</div>`;
          }).join('')}</div>
        </div>`).join('')}
    </div>`).join('');
}

function renderProg(){
  const n=document.getElementById('psel').value;
  const ss=H.filter(s=>s.exercises?.some(e=>e.name===n)).sort((a,b)=>a.week-b.week);
  const ws=ss.map(s=>{const ex=s.exercises.find(e=>e.name===n);const a=ex.sets.filter(t=>t.weight).map(t=>parseFloat(t.weight));return a.length?Math.max(...a):0;});
  const lb=ss.map(s=>`S${s.week}`);

  // Draw chart
  const cv=document.getElementById('pchart'),ctx=cv.getContext('2d');
  ctx.clearRect(0,0,cv.width,cv.height);
  if(!ss.length){
    cv.width=320;cv.height=80;
    ctx.fillStyle='#9a94b4';ctx.font='13px Nunito,sans-serif';ctx.textAlign='center';
    ctx.fillText('Sin datos aún',160,44);
    document.getElementById('pstats').innerHTML='<div class="sbox"><div class="sval">—</div><div class="slb">Máx kg</div></div><div class="sbox"><div class="sval">—</div><div class="slb">Último</div></div><div class="sbox"><div class="sval">—</div><div class="slb">Progreso</div></div>';
    document.getElementById('progCompare').innerHTML='';
    return;
  }
  const W=cv.offsetWidth||340,H2=160;
  cv.width=W*devicePixelRatio;cv.height=H2*devicePixelRatio;cv.style.width=W+'px';cv.style.height=H2+'px';ctx.scale(devicePixelRatio,devicePixelRatio);
  const pL=42,pR=14,pT=14,pB=34,cW2=W-pL-pR,cH=H2-pT-pB;
  const mn=Math.max(0,Math.min(...ws)-5),mx=Math.max(...ws)+5;
  const px=i=>pL+(i/Math.max(1,ws.length-1))*cW2,py=w=>pT+cH-((w-mn)/Math.max(1,mx-mn))*cH;
  for(let g=0;g<=4;g++){
    const y=pT+(g/4)*cH;ctx.strokeStyle='#dcd7ee';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(pL,y);ctx.lineTo(pL+cW2,y);ctx.stroke();
    ctx.fillStyle='#9a94b4';ctx.font='10px sans-serif';ctx.textAlign='right';
    ctx.fillText((mx-(g/4)*(mx-mn)).toFixed(0)+'kg',pL-4,y+4);
  }
  ctx.beginPath();ctx.moveTo(px(0),pT+cH);
  ws.forEach((w,i)=>ctx.lineTo(px(i),py(w)));
  ctx.lineTo(px(ws.length-1),pT+cH);ctx.closePath();
  const gr=ctx.createLinearGradient(0,pT,0,pT+cH);
  gr.addColorStop(0,'rgba(155,135,212,0.22)');gr.addColorStop(1,'rgba(155,135,212,0)');
  ctx.fillStyle=gr;ctx.fill();
  ctx.beginPath();
  ws.forEach((w,i)=>i===0?ctx.moveTo(px(i),py(w)):ctx.lineTo(px(i),py(w)));
  ctx.strokeStyle='#9b87d4';ctx.lineWidth=2.5;ctx.lineJoin='round';ctx.lineCap='round';ctx.stroke();
  ws.forEach((w,i)=>{
    ctx.beginPath();ctx.arc(px(i),py(w),5,0,Math.PI*2);ctx.fillStyle='#9b87d4';ctx.fill();
    ctx.beginPath();ctx.arc(px(i),py(w),2.5,0,Math.PI*2);ctx.fillStyle='#faf9fd';ctx.fill();
  });
  const step=Math.max(1,Math.ceil(lb.length/6));
  lb.forEach((l,i)=>{
    if(i%step!==0&&i!==lb.length-1)return;
    ctx.fillStyle='#9a94b4';ctx.font='9px sans-serif';ctx.textAlign='center';
    ctx.fillText(l,px(i),H2-6);
  });

  // Week by week comparison
  const cmp=document.getElementById('progCompare');
  if(ss.length>1){
    let rows='';
    ss.forEach((s,i)=>{
      const w=ws[i];
      const prev=i>0?ws[i-1]:null;
      const diff=prev!==null?(w-prev):null;
      const diffStr=diff===null?'':(diff>0?`<span class="week-row-diff up">+${diff.toFixed(1)}kg ↑</span>`:diff<0?`<span class="week-row-diff down">${diff.toFixed(1)}kg ↓</span>`:`<span class="week-row-diff same">= mismo</span>`);
      rows+=`<div class="week-row-prog">
        <div class="week-row-label">Sem. ${s.week}</div>
        <div class="week-row-val">${w} kg</div>
        <div>${diffStr}</div>
      </div>`;
    });
    cmp.innerHTML=`<div class="prog-compare-title">Progresión semana a semana</div>${rows}`;
  } else {
    cmp.innerHTML='';
  }

  const mx2=Math.max(...ws),lk=ws[ws.length-1],df=ws.length>1?(lk-ws[0]).toFixed(1):null;
  document.getElementById('pstats').innerHTML=`
    <div class="sbox"><div class="sval">${mx2}</div><div class="slb">Máx kg</div></div>
    <div class="sbox"><div class="sval">${lk}</div><div class="slb">Último</div></div>
    <div class="sbox"><div class="sval">${df===null?'—':(parseFloat(df)>=0?'+':'')+df}</div><div class="slb">Total</div></div>`;
}

