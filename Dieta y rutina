  $('pList').innerHTML=DIET.map((m,i)=>{const s=d.m[i]||{d:0,c:{}};
    return `<div class="ncard" style="${s.d?'border-color:var(--ok)':''}"><div class="mh"><b>${m.t} · ${m.n}</b><button class="addb" style="background:${s.d?'var(--ok)':'var(--accent)'}" onclick="pDone(${i})">${s.d?'✓ Hecho':'Marcar'}</button></div>${m.f.map(x=>`<div style="font-size:13px;font-weight:600;padding:2px 0">• ${x.t}</div>`).join('')}${(m.g||[]).map(([l,o],gi)=>`<div class="slbl">${l}: elige una</div><div style="display:flex;flex-wrap:wrap;gap:6px">${o.map((t,oi)=>`<button class="opt${s.c[gi]===oi?' on':''}" onclick="pSel(${i},${gi},${oi})">${t.t}<br><small style="opacity:.75">${t.k} kcal</small></button>`).join('')}</div>`).join('')}</div>`;}).join('')
  +`<div class="ncard"><div class="mh"><b>Suplementos y extras</b></div>${XT.map((t,i)=>`<div class="ent" onclick="pX(${i})"><span class="sdone${d.x[i]?' on':''}" style="display:flex;align-items:center;justify-content:center">${d.x[i]?'✓':''}</span>${t.t}${t.k?' <small>('+t.k+' kcal)</small>':''}</div>`).join('')}</div><div class="ncard" style="font-size:12px;line-height:1.7;color:var(--muted);font-weight:600">${RULES}</div>`;
}
function setMode(m){document.querySelectorAll('#bnav button').forEach(b=>{b.style.display=(b.dataset.m==='both'||b.dataset.m===m)?'flex':'none';});}
function goHome(){$('bnav').style.display='none';switchV('Home');}
function enter(m){setMode(m);$('bnav').style.display='flex';switchV(m==='gym'?'Workout':'Plan');}
function renderHome(){
  const t=dk(new Date()),k=(N.log[t]||[]).reduce((a,e)=>a+e.kcal,0)+planTot(t).k,pm=(P[t]||{m:{}}).m,nm=Object.keys(pm).filter(i=>pm[i].d).length;
  $('vHome').innerHTML=`<div style="font-size:24px;font-weight:800;margin:6px 0 2px">Hola, Iris 👋</div><div style="color:var(--muted);font-weight:700;margin-bottom:18px">¿Qué toca hoy?</div>
  <button class="hc" style="background:linear-gradient(135deg,#9b87d4,#c4a0e0)" onclick="enter('gym')"><span>🏋️ ENTRENO</span><b>${R.meta.name}</b><span>Semana ${cW} · ${MCL[mci(cW)]} · ${Object.keys(R.days).length} días</span></button>
  <button class="hc" style="background:linear-gradient(135deg,#7bc4a4,#8fd3c8)" onclick="enter('nutri')"><span>🥗 NUTRICIÓN</span><b>Mi dieta</b><span>${nm}/${DIET.length} comidas hoy · ${k} / ${N.goal.k} kcal en el diario</span></button>`;
}

// ── ENTRENO PRO: cronómetros, copiar semana anterior, pistas ──
function hint(tr,p){const m=String(tr).match(/(\d+)-(\d+)/);if(!m||!p)return'';const ok=p.filter(x=>x.weight&&x.reps);
  return ok.length&&ok.every(x=>parseFloat(x.reps)>=+m[2])?'<div class="elast" style="color:var(--accent2)">💡 Completaste el rango: prueba +2,5 kg</div>':'';}
function copyPrev(ei){const ex=R.days[cD][ei],p=getPrevSets(ex.name,cD,cW);if(!p)return;const k=sk(cD,cW);
  SD[k][ei]=SD[k][ei]||es(ex.sets);p.forEach((x,si)=>{if(SD[k][ei][si]){SD[k][ei][si].weight=x.weight||'';SD[k][ei][si].reps=x.reps||'';}});
  renderEx();togEx(ei);}
init();goHome();
</script>
