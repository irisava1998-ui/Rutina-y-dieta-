<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Gym Tracker">
<title>Gym Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#f0edf8;--surface:#faf9fd;--surface2:#e8e4f4;
  --border:#dcd7ee;--accent:#9b87d4;--accent2:#e8a4b8;
  --soft:#c4b8ea;--text:#2e2a40;--muted:#9a94b4;
  --ok:#7bc4a4;--danger:#e08888;--warn:#f0c080;--r:16px;
}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:'Nunito',sans-serif;overflow:hidden}
#app{display:flex;flex-direction:column;height:100dvh;max-width:430px;margin:0 auto}
.hdr{background:var(--surface);border-bottom:1px solid var(--border);padding:14px 16px 10px;flex-shrink:0;box-shadow:0 2px 12px rgba(155,135,212,.08)}
.hdr-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px}
.logo{font-size:19px;font-weight:800;color:var(--accent)}
.logo b{color:var(--accent2)}
.hdr-right{display:flex;align-items:center;gap:8px}
.wbadge{background:var(--accent);color:#fff;font-size:12px;font-weight:700;padding:5px 12px;border-radius:20px}
.sbtn{width:32px;height:32px;border-radius:50%;border:1.5px solid var(--border);background:var(--surface2);color:var(--muted);font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.sbtn.on{background:var(--accent);color:#fff;border-color:var(--accent)}
.wsub{font-size:11px;color:var(--muted);font-weight:600;margin-bottom:8px}
.wrow{display:flex;align-items:center;gap:8px}
.wnav{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--border);background:var(--surface2);color:var(--accent);font-size:18px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.wscroll{flex:1;overflow-x:auto;display:flex;gap:4px;padding:2px 0;scrollbar-width:none}
.wscroll::-webkit-scrollbar{display:none}
.wbtn{flex-shrink:0;width:34px;height:30px;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;border:1.5px solid var(--border);background:var(--surface);color:var(--muted);font-family:inherit}
.wbtn.on{background:var(--accent);color:#fff;border-color:var(--accent)}
.wbtn.mc{background:var(--surface2);border-color:var(--soft);color:var(--accent)}
.dtabs{display:flex;gap:6px;padding:10px 14px;overflow-x:auto;flex-shrink:0;background:var(--bg);scrollbar-width:none}
.dtabs::-webkit-scrollbar{display:none}
.dtab{flex-shrink:0;padding:8px 18px;border-radius:30px;font-size:13px;font-weight:700;cursor:pointer;border:1.5px solid var(--border);background:var(--surface);color:var(--muted);font-family:inherit}
.dtab.on{background:var(--accent);color:#fff;border-color:var(--accent)}
.scroll{flex:1;overflow-y:auto;padding:10px 14px 110px}
.scroll::-webkit-scrollbar{width:3px}
.scroll::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.ecard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);margin-bottom:10px;overflow:hidden;transition:border-color .2s,box-shadow .2s}
.ecard.lit{border-color:var(--soft);box-shadow:0 2px 12px rgba(155,135,212,.12)}
.ehdr{display:flex;align-items:center;justify-content:space-between;padding:13px 14px;cursor:pointer;user-select:none}
.ename{font-size:14px;font-weight:700;line-height:1.3}
.enote{font-size:11px;color:var(--muted);margin-top:2px;font-style:italic}
.emeta{font-size:11px;color:var(--accent);font-weight:700;margin-top:3px}
.elast{font-size:11px;color:var(--ok);font-weight:700;margin-top:2px}
.echev{width:28px;height:28px;border-radius:50%;background:var(--surface2);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14px;margin-left:8px;flex-shrink:0;transition:all .2s}
.echev.open{background:var(--accent);color:#fff}
.sbody{display:none;padding:0 14px 14px;border-top:1px solid var(--border);background:var(--bg)}
.sbody.open{display:block}
.slbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin:10px 0 6px;font-weight:700}
/* 6 columns: num | reps | kg | rir | done | prev */
.sgrid{display:grid;grid-template-columns:24px 1fr 1fr 52px 32px;gap:4px;align-items:start;margin-bottom:8px}
.snum{background:var(--surface2);border-radius:8px;height:36px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--accent);font-weight:800}
.sinput{background:var(--surface);border:1.5px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:15px;font-weight:700;padding:8px 4px;text-align:center;width:100%;outline:none;-webkit-appearance:none}
.sinput:focus{border-color:var(--accent)}
.sinput.rir-f{border-color:var(--danger);color:var(--danger)}
.sdone{width:32px;height:36px;border-radius:10px;border:1.5px solid var(--border);background:var(--surface);color:var(--muted);cursor:pointer;font-size:14px;font-family:inherit}
.sdone.on{background:var(--ok);border-color:var(--ok);color:#fff}
.clbls{display:grid;grid-template-columns:24px 1fr 1fr 52px 32px;gap:4px;margin-bottom:4px}
.clbl{font-size:10px;color:var(--muted);text-align:center;font-weight:700}
/* Previous week row */
.prev-row{display:grid;grid-template-columns:24px 1fr 1fr 52px 32px;gap:4px;margin-top:-4px;margin-bottom:6px}
.prev-cell{font-size:10px;color:var(--ok);font-weight:700;text-align:center;padding:2px 0}
.prev-label{font-size:10px;color:var(--ok);font-weight:700;text-align:center}
/* RIR helper buttons */
.rir-helpers{display:flex;gap:4px;margin-bottom:8px}
.rir-chip{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:1.5px solid var(--border);background:var(--surface);color:var(--muted);font-family:inherit}
.rir-chip.sel{background:var(--accent);color:#fff;border-color:var(--accent)}
.rir-chip.sel-f{background:var(--danger);color:#fff;border-color:var(--danger)}
.bnav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;background:var(--surface);border-top:1px solid var(--border);display:flex;padding:8px 0 22px;z-index:100;box-shadow:0 -4px 20px rgba(155,135,212,.08)}
.nbtn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;padding:6px;background:none;border:none;color:var(--muted);font-family:inherit;font-size:10px;font-weight:700}
.nbtn.on{color:var(--accent)}
.nicon{font-size:22px}
.fab{position:fixed;bottom:82px;right:max(16px,calc(50% - 215px + 16px));background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;border-radius:50px;padding:13px 20px;font-family:inherit;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 4px 20px rgba(155,135,212,.35);display:flex;align-items:center;gap:8px;z-index:99}
.toast{position:fixed;top:16px;left:50%;transform:translateX(-50%) translateY(-80px);background:var(--ok);color:#fff;border-radius:30px;padding:11px 22px;font-weight:800;font-size:14px;transition:transform .3s cubic-bezier(.34,1.56,.64,1);z-index:999;white-space:nowrap;box-shadow:0 4px 20px rgba(123,196,164,.4)}
.toast.show{transform:translateX(-50%) translateY(0)}
.hcard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);margin-bottom:10px;overflow:hidden}
.hhead{padding:12px 14px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:var(--surface2)}
.hdate{font-weight:800;font-size:14px}
.hmeta{font-size:11px;color:var(--muted);margin-top:1px;font-weight:600}
.hday{background:var(--accent);color:#fff;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700}
.hex{padding:10px 14px;border-bottom:1px solid var(--border)}
.hex:last-child{border-bottom:none}
.hexn{font-weight:700;font-size:13px;margin-bottom:5px}
.hsets{display:flex;gap:6px;flex-wrap:wrap}
.hchip{background:var(--surface2);border-radius:8px;padding:4px 10px;font-size:11px;color:var(--muted);font-weight:600}
.hchip b{color:var(--accent)}
.hchip.fallo{background:#fdeaea}
.hchip.fallo b{color:var(--danger)}
.psel{width:100%;background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);color:var(--text);font-family:inherit;font-size:14px;font-weight:700;padding:12px 14px;margin-bottom:14px;outline:none}
.pbox{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:12px}
.ptitle{font-size:11px;color:var(--muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;font-weight:700}
.sgrid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.sbox{background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 8px;text-align:center}
.sval{font-size:26px;font-weight:800;color:var(--accent)}
.slb{font-size:10px;color:var(--muted);margin-top:2px;font-weight:700}
.ssec{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:14px}
.stitle{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}
.ubtn{display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-radius:14px;padding:14px 20px;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 4px 16px rgba(155,135,212,.3);width:100%;border:none;font-family:inherit}
.ubtn:disabled{opacity:.6;cursor:default}
.al{margin-top:12px;border-radius:12px;padding:10px 14px;font-size:13px;font-weight:600}
.al.err{background:#fdeaea;border:1.5px solid var(--danger);color:var(--danger)}
.al.ok{background:#e8f7f0;border:1.5px solid var(--ok);color:#4a9e78}
.tips{background:var(--surface2);border-radius:var(--r);padding:14px}
.ttitle{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.ttext{font-size:12px;color:var(--muted);line-height:1.8}
.rname{font-size:18px;font-weight:800;color:var(--accent)}
.rsub{font-size:13px;color:var(--muted);margin-top:4px;font-weight:600}
.rdays{margin-top:10px;display:flex;flex-direction:column;gap:3px}
.rday{font-size:12px;font-weight:600}
.rday span{color:var(--accent)}
.empty{text-align:center;padding:60px 20px;color:var(--muted)}
.eicon{font-size:52px;margin-bottom:12px}
.etxt{font-weight:700;font-size:15px;line-height:1.5}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.spin{display:inline-block;animation:spin 1s linear infinite}
/* Progress week comparison */
.prog-compare{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:12px}
.prog-compare-title{font-size:11px;color:var(--muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;font-weight:700}
.week-row-prog{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)}
.week-row-prog:last-child{border-bottom:none}
.week-row-label{font-size:12px;font-weight:700;color:var(--muted)}
.week-row-val{font-size:14px;font-weight:800;color:var(--text)}
.week-row-diff{font-size:12px;font-weight:700}
.week-row-diff.up{color:var(--ok)}
.week-row-diff.down{color:var(--danger)}
.week-row-diff.same{color:var(--muted)}

.dnav{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.dnav button{width:34px;height:34px;border-radius:50%;border:1.5px solid var(--border);background:var(--surface2);color:var(--accent);font-size:18px;font-weight:700}.dnav b{font-size:15px}
.ncard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:12px}
.ring{width:118px;height:118px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.ring>div{width:90px;height:90px;border-radius:50%;background:var(--surface);display:flex;flex-direction:column;align-items:center;justify-content:center}
.mbar{height:7px;border-radius:4px;background:var(--surface2);overflow:hidden;margin:3px 0 8px}.mbar i{display:block;height:100%;border-radius:4px}
.mrow{display:flex;justify-content:space-between;font-size:12px;font-weight:700}.mh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.mh b{font-size:14px}
.addb{border:none;background:var(--accent);color:#fff;border-radius:20px;padding:6px 14px;font-weight:800;font-size:12px;font-family:inherit}
.ent{display:flex;gap:10px;align-items:center;padding:8px 0;border-top:1px solid var(--border);font-size:13px}.ent img{width:40px;height:40px;border-radius:10px;object-fit:cover}.ent .x{margin-left:auto;color:var(--muted);background:none;border:none;font-size:16px}
.sheet{position:fixed;inset:0;background:rgba(46,42,64,.45);z-index:300;display:none;align-items:flex-end}.sheet>div{background:var(--surface);width:100%;max-width:430px;margin:0 auto;border-radius:22px 22px 0 0;padding:16px;max-height:90dvh;overflow-y:auto}
.fin{width:100%;background:var(--bg);border:1.5px solid var(--border);border-radius:10px;padding:10px;font-family:inherit;font-size:15px;font-weight:700;color:var(--text);outline:none}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:6px 0}.g4 label{font-size:10px;color:var(--muted);font-weight:700}
.sr{padding:9px 0;border-top:1px solid var(--border);font-size:13px;font-weight:700}.sr small{display:block;color:var(--muted);font-weight:600}
.btn2{flex:1;border:1.5px solid var(--border);background:var(--surface2);border-radius:12px;padding:10px;font-family:inherit;font-weight:800;font-size:13px;color:var(--accent);text-align:center}
.opt{border:1.5px solid var(--border);background:var(--surface);border-radius:12px;padding:7px 10px;font-family:inherit;font-size:12px;font-weight:700;color:var(--text);text-align:left}.opt.on{background:var(--accent);color:#fff;border-color:var(--accent)}
.hc{display:block;width:100%;text-align:left;border:none;border-radius:22px;padding:22px;margin-bottom:14px;color:#fff;font-family:inherit;box-shadow:0 6px 20px rgba(155,135,212,.25)}.hc b{font-size:22px;display:block;margin:6px 0 4px}.hc span{font-size:13px;font-weight:700;opacity:.92}
</style>
</head>
<body>
<div id="app">
  <div class="hdr">
    <div class="hdr-top">
      <div>
        <div class="logo" id="logo">Gym <b>Tracker</b></div>
        <div class="wsub" id="wsub">—</div>
      </div>
      <div class="hdr-right">
        <div class="wbadge" id="wbadge">Sem. 1</div>
        <button class="sbtn" id="sbtn" onclick="toggleSettings()">⚙️</button>
      </div>
    </div>
    <div class="wrow" id="wrow">
      <button class="wnav" onclick="shiftW(-1)">‹</button>
      <div class="wscroll" id="wscroll"></div>
      <button class="wnav" onclick="shiftW(1)">›</button>
    </div>
  </div>

  <div id="vWorkout" style="display:flex;flex-direction:column;flex:1;overflow:hidden">
    <div class="dtabs" id="dtabs"></div>
    <div class="scroll" id="exlist"></div>
  </div>
  <div id="vHistory" style="display:none;flex:1;overflow-y:auto;padding:14px 14px 100px"></div>
  <div id="vProgress" style="display:none;flex:1;overflow-y:auto;padding:14px 14px 100px">
    <select class="psel" id="psel" onchange="renderProg()"></select>
    <div class="pbox"><div class="ptitle">Peso máximo por sesión (kg)</div><canvas id="pchart" style="width:100%;display:block"></canvas></div>
    <div class="prog-compare" id="progCompare"></div>
    <div class="sgrid3" id="pstats"></div>
  </div>
  <div id="vSettings" style="display:none;flex:1;overflow-y:auto;padding:14px 14px 100px">
    <div class="ssec">
      <div class="stitle">Rutina actual</div>
      <div class="rname" id="sname">—</div>
      <div class="rsub" id="ssub">—</div>
      <div class="rdays" id="sdays"></div>
    </div>
    <div class="ssec">
      <div class="stitle">Cargar nueva rutina</div>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.6">Sube el Excel (.xlsx) de tu nuevo mesociclo y la app lo leerá automáticamente.</p>
      <input type="file" id="finput" accept=".xlsx" style="display:none" onchange="handleFile(this)">
      <button class="ubtn" id="ubtn" onclick="document.getElementById('finput').click()">📊 Subir Excel del nuevo mesociclo</button>
      <div id="ualert" style="display:none" class="al"></div>
    </div>
    <div class="tips">
      <div class="ttitle">💡 Formato del Excel</div>
      <div class="ttext">
        • Cada hoja = un día (DÍA 1, DÍA 2...)<br>
        • Col A: nombre del ejercicio<br>
        • Col D, F, H, J, L, N: microciclos 1-2 a 11-12<br>
        • Formato: "3x7-9 (2-3)" → reps 7-9, RIR 2-3<br>
        • (F) = fallo muscular<br>
        • Tu historial no se borra al cambiar rutina
      </div>
    </div>
  </div>

  <div id="vHome" style="display:none;flex:1;overflow-y:auto;padding:18px 16px"></div>
<div id="vPlan" style="display:none;flex:1;overflow-y:auto;padding:14px 14px 100px"><div class="dnav"><button onclick="pShift(-1)">‹</button><b id="pDate"></b><button onclick="pShift(1)">›</button></div><div class="ncard" id="pSum"></div><div id="pList"></div></div>
<div id="vNutri" style="display:none;flex:1;overflow-y:auto;padding:14px 14px 100px"><div class="dnav"><button onclick="nShift(-1)">‹</button><b id="nDate"></b><button onclick="nShift(1)">›</button></div><div class="ncard" id="nSum"></div><div id="nMeals"></div></div>
<div class="sheet" id="nSheet"><div>
<div class="mh"><b id="sTitle">Añadir alimento</b><button class="x" onclick="closeS()" style="background:none;border:none;font-size:20px;color:var(--muted)">✕</button></div>
<div style="display:flex;gap:6px"><input class="fin" id="fq" placeholder="Buscar (ej. yogur griego)" onkeydown="if(event.key==='Enter')sf()"><button class="addb" onclick="sf()">Buscar</button></div>
<div style="display:flex;gap:6px;margin:8px 0"><label class="btn2">📷 Código de barras<input type="file" accept="image/*" capture="environment" style="display:none" onchange="scan(this)"></label><label class="btn2">🖼️ Foto del plato<input type="file" accept="image/*" capture="environment" style="display:none" onchange="photo(this)"></label></div>
<div id="sMsg" style="font-size:12px;color:var(--muted);font-weight:600;margin-bottom:4px"></div><div id="sRes"></div><div id="qr" style="display:none"></div>
<div style="margin-top:8px"><input class="fin" id="fn" placeholder="Nombre (o escríbelo a mano)"><div id="pv" style="margin:6px 0"></div>
<div class="g4"><div><label>Gramos</label><input class="fin" id="fg" type="number" inputmode="decimal" value="100" oninput="pvw()"></div><div><label>kcal/100</label><input class="fin" id="fk" type="number" inputmode="decimal" oninput="pvw()"></div><div><label>Prot/100</label><input class="fin" id="fp" type="number" inputmode="decimal" oninput="pvw()"></div><div><label>HC/100</label><input class="fin" id="fc" type="number" inputmode="decimal" oninput="pvw()"></div></div>
<div class="g4" style="grid-template-columns:1fr 3fr"><div><label>Grasa/100</label><input class="fin" id="ff" type="number" inputmode="decimal" oninput="pvw()"></div><div></div></div>
<div id="pvt" style="font-size:13px;font-weight:800;color:var(--accent);margin:4px 0 10px"></div><button class="ubtn" onclick="addE()">Añadir al diario</button></div>
</div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<button class="fab" id="fab" onclick="saveSession()">💾 Guardar sesión</button>
  <nav class="bnav" id="bnav" style="display:none">
    <button class="nbtn" data-m="both" onclick="goHome()"><span class="nicon">🏠</span>Inicio</button>
    <button class="nbtn on" id="nW" data-m="gym" onclick="switchV('Workout')"><span class="nicon">🏋️</span>Entreno</button>
    <button class="nbtn" id="nHistory" data-m="gym" onclick="switchV('History')"><span class="nicon">📋</span>Historial</button>
    <button class="nbtn" id="nProgress" data-m="gym" onclick="switchV('Progress')"><span class="nicon">📈</span>Progreso</button>
    <button class="nbtn" id="nPlan" data-m="nutri" onclick="switchV('Plan')"><span class="nicon">🥗</span>Mi dieta</button>
    <button class="nbtn" id="nNutri" data-m="nutri" onclick="switchV('Nutri')"><span class="nicon">🍎</span>Diario kcal</button>
  </nav>
  <div class="toast" id="toast"></div>
